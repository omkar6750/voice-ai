VOICE_ENV=dev
VOICE_MCP_LOCAL_BASE_URL=http://127.0.0.1:8000
# Required in production; use the externally reachable HTTPS API origin.
VOICE_MCP_PUBLIC_BASE_URL=
# Set true to log method, path, status, and elapsed time for local API requests.
VOICE_DEBUG_PERF=false
# Dev only: emit allowlisted validation locations (never values, messages, or tracebacks).
VOICE_DEBUG_DIAGNOSTICS=false
VOICE_DATABASE_URL=postgresql+asyncpg://voice:voice@localhost:55432/voice
VOICE_DB_PORT=55432
VOICE_RECORDINGS_DIR=data/recordings
VOICE_CARTESIA_API_KEY=
VOICE_GROQ_API_KEY=
VOICE_GEMINI_API_KEY=
VOICE_ISOQUANT_API_KEY=
VOICE_GNANI_API_KEY=
VOICE_SARVAM_API_KEY=
VOICE_JEV_API_KEY=
# Interim owner of the unscoped Original org/omkar data. Email must be Clerk-verified.
# Once the account exists, prefer the immutable Clerk user ID and remove the email fallback.
# Set only after the founder has signed up and their Clerk user ID is verified.
# Never use an email address or a default value as a platform-admin credential.
# Required for the separate runtime service; keep all service tokens server-side.
VOICE_RUNTIME_SERVICE_TOKEN=
# Independent high-entropy secret for signed human callback slots, if enabled.
VOICE_CALLBACK_SLOT_SIGNING_KEY=
# Backend-only Clerk development values. The publishable key belongs in
# apps/dashboard/.env.local as VITE_CLERK_PUBLISHABLE_KEY.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
VOICE_CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000
VOICE_ORGANIZATION_CREATION_ENABLED=true
# Google OAuth is the platform app used for user-authorized calendar connections.
VOICE_GOOGLE_CALENDAR_CLIENT_ID=
VOICE_GOOGLE_CALENDAR_CLIENT_SECRET=
VOICE_GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar-integrations/google/callback
# Dashboard origin to return to after OAuth. Set its actual Vite port locally,
# or the hosted dashboard origin in production. Blank uses the API origin.
VOICE_DASHBOARD_BASE_URL=http://127.0.0.1:5173
# JSON object: {"key-id":"Fernet-base64-key"}. Never commit values.
VOICE_INTEGRATION_KEYS={}
VOICE_INTEGRATION_ACTIVE_KEY=

# Public origin used for provider webhooks and OAuth callbacks when exposed through ngrok
VOICE_PUBLIC_BASE_URL=https://your-ngrok-domain.ngrok-free.dev
VOICE_DEBUG_PERF=true
# API -> runtime control; public runtime origin is also used by browser/Twilio media.
VOICE_RUNTIME_CONTROL_TOKEN=
VOICE_RUNTIME_CONTROL_TOKEN_PREVIOUS=
VOICE_RUNTIME_SERVICE_TOKEN_PREVIOUS=
VOICE_RUNTIME_BASE_URL=http://127.0.0.1:8001
VOICE_RUNTIME_PUBLIC_BASE_URL=http://127.0.0.1:8001
VOICE_ENABLE_INBOUND_API_LOGS=false
VOICE_ENABLE_OUTBOUND_API_LOGS=false
VOICE_INBOUND_API_LOGS_NO_TRUNCATE=false
VOICE_OUTBOUND_API_LOGS_NO_TRUNCATE=false
VOICE_API_LOG_MAX_BODY_CHARS=8192
VOICE_LOG_LEVEL=INFO
VOICE_LOG_FORMAT=auto
VOICE_LOG_COLOR=auto
