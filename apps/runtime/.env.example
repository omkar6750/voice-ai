VOICE_ENV=dev
VOICE_API_BASE_URL=http://127.0.0.1:8000
VOICE_RUNTIME_PUBLIC_BASE_URL=http://127.0.0.1:8001
# Generate two different high-entropy secrets; copy the pair to API server configuration.
VOICE_RUNTIME_CONTROL_TOKEN=
VOICE_RUNTIME_SERVICE_TOKEN=
VOICE_RUNTIME_CONTROL_TOKEN_PREVIOUS=
VOICE_RUNTIME_SERVICE_TOKEN_PREVIOUS=
VOICE_RUNTIME_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
VOICE_MAX_CONCURRENT_CALLS=4
VOICE_RUNTIME_CPU_BUDGET=1
VOICE_RUNTIME_MAX_LOOP_LAG_MS=100
VOICE_CALL_MAX_DURATION_SECONDS=600
# Maximum wait from dialing for an active modem call; carrier may end it earlier.
VOICE_SIM7600_CONNECT_TIMEOUT_SECONDS=90
# Release verification deadline must exceed the stable idle period.
VOICE_SIM7600_RELEASE_TIMEOUT_SECONDS=30
VOICE_SIM7600_RELEASE_STABLE_SECONDS=15
VOICE_RUNTIME_SHUTDOWN_SECONDS=285
VOICE_RUNTIME_MIN_FREE_SPOOL_BYTES=536870912
VOICE_RUNTIME_SPOOL_DIR=data/runtime-evidence
VOICE_RECORDINGS_DIR=data/runtime-recordings
VOICE_HOSTED_CALLS_ENABLED=false
VOICE_ENABLE_INBOUND_API_LOGS=false
VOICE_ENABLE_OUTBOUND_API_LOGS=false
VOICE_INBOUND_API_LOGS_NO_TRUNCATE=false
VOICE_OUTBOUND_API_LOGS_NO_TRUNCATE=false
VOICE_API_LOG_MAX_BODY_CHARS=8192
VOICE_DEBUG_PERF=false
# Temporary local PCM activity diagnostics for investigating turn detection.
VOICE_MODEM_TURN_DIAGNOSTICS=false
VOICE_LOG_LEVEL=INFO
VOICE_LOG_FORMAT=auto
VOICE_LOG_COLOR=auto
