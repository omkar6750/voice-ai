# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm AS builder
COPY --from=ghcr.io/astral-sh/uv:0.9.17 /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock .python-version ./
# Check lock freshness, then install only the frozen production dependency graph.
RUN uv lock --check && uv sync --frozen --no-dev --no-install-project --no-editable
COPY apps/api ./apps/api
COPY packages/voice_runtime ./packages/voice_runtime
COPY packages/voice_shared ./packages/voice_shared
COPY apps/runtime ./apps/runtime
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=10000 \
    PATH="/app/.venv/bin:$PATH" HOME=/app
WORKDIR /app
# soundfile needs libsndfile; libportaudio supports imported audio transports.
# Browser/Twilio do not require an audio device or a modem in this container.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libsndfile1 libportaudio2 libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 voiceapp \
    && useradd --uid 10001 --gid voiceapp --no-create-home --home-dir /app voiceapp \
    && mkdir -p /app/data/recordings /app/data/runtime-evidence /app/data/runtime-recordings /app/data/logs \
    && chown -R voiceapp:voiceapp /app
COPY --from=builder --chown=voiceapp:voiceapp /app/.venv /app/.venv
USER 10001:10001
EXPOSE 10000
# One process owns in-memory leases. DB fences must also survive restart/overlap.
# Start only the runtime: never migrate, schedule cleanup, dial, or run the demo here.
CMD ["sh", "-c", "exec uvicorn voice_runner.main:app --host 0.0.0.0 --port ${PORT:?PORT is required} --workers 1 --timeout-graceful-shutdown 285 --no-access-log"]
