{
  "name": "voice-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript ../../data/openapi.json -o src/generated/api.d.ts && node scripts/generate-schema.mjs",
    "dev": "vite",
