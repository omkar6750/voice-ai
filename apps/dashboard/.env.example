# Copy to .env.local for local Vite development and fill in your Clerk instance's
# public publishable key. This key is public; never put a Clerk secret here.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
# Local API origin. Production builds set this in Netlify's environment instead.
VITE_API_ORIGIN=http://localhost:8000
# Set true to log request timings in the browser console while diagnosing local latency.
VITE_DEBUG_PERF=false
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_AFTER_SIGN_IN_URL=/runs
VITE_CLERK_AFTER_SIGN_UP_URL=/organizations
VITE_CLERK_ORGANIZATION_PROFILE_URL=/organizations/profile
VITE_CLERK_CREATE_ORGANIZATION_URL=/organizations/create
VITE_CLERK_INVITATION_REDIRECT_URL=/accept-invitation

# Public runtime health origin for the platform-owner paired keep-awake control.
VITE_RUNTIME_ORIGIN=http://localhost:8001
